# Portfolio AI Accountability Playbook - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================

# Public domain for the application (optional)
NEXT_PUBLIC_DOMAIN=product-os.frederickli.pro

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Leave empty to disable Google Analytics tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID
# Get this from your Clarity dashboard
# Leave empty to disable Clarity tracking
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ============================================================================
# CONFIGURABLE COMPANY NAMES
# These values replace hardcoded company names throughout the interface.
# Defaults are shown - customize for your deployment.
# ============================================================================

# PE (Private Equity) Firm name
# Default: [PE Firm]
NEXT_PUBLIC_PE_FIRM_NAME=[PE Firm]

# Portfolio Company name
# Default: [Portfolio Co]
NEXT_PUBLIC_PORTFOLIO_CO_NAME=[Portfolio Co]

# Product/Software name
# Default: [Software]
NEXT_PUBLIC_PRODUCT_NAME=[Software]

# Developer name for attribution
# Default: developer
NEXT_PUBLIC_DEVELOPER_NAME=developer

# CEO name for scenario context
# Default: [CEO Name]
NEXT_PUBLIC_CEO_NAME=[CEO Name]

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Required for database features; leave empty for mock data only
MONGODB_URI=
